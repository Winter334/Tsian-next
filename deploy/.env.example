TSIAN_IMAGE_NAME=tsian-platform
TSIAN_IMAGE_TAG=local
TSIAN_CONTAINER_NAME=tsian-platform
TSIAN_BUILD_CONTEXT=..

TSIAN_HOST_BIND=127.0.0.1
TSIAN_HOST_PORT=18080
TSIAN_HOST_DATA_DIR=/opt/tsian/data

TSIAN_ADDR=:8080
TSIAN_BASE_URL=https://beta.example.com

TSIAN_DISCORD_CLIENT_ID=
TSIAN_DISCORD_CLIENT_SECRET=
TSIAN_DISCORD_REGISTRATION_GUILD_ID=
TSIAN_DISCORD_REGISTRATION_ROLE_IDS=

TSIAN_DB_PATH=/data/tsian.db
TSIAN_DATA_DIR=/data
TSIAN_STATIC_DIR=/app/public
TSIAN_COOKIE_SECURE=true
TSIAN_MOCK_AUTH=false
