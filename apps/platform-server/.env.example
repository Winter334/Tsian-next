# platform-server local environment example
# Copy to apps/platform-server/.env.local for local-only secrets.

# For Vite dev, use http://localhost:5173 so OAuth callback and frontend cookie origin match.
TSIAN_BASE_URL=http://localhost:5173
TSIAN_ADDR=:8080
TSIAN_COOKIE_SECURE=false

# Discord OAuth application credentials.
TSIAN_DISCORD_CLIENT_ID=
TSIAN_DISCORD_CLIENT_SECRET=

# Optional: allow only new Discord registrations from a guild + role list.
# Configure both variables together, or leave both empty.
TSIAN_DISCORD_REGISTRATION_GUILD_ID=
TSIAN_DISCORD_REGISTRATION_ROLE_IDS=

# Optional local paths.
TSIAN_DB_PATH=data/tsian.db
TSIAN_DATA_DIR=data
TSIAN_STATIC_DIR=../platform-web/dist

# Optional mock login for local account/session testing without Discord.
TSIAN_MOCK_AUTH=false
