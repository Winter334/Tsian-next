{
  "schemaVersion": 1,
  "inputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "operation": {
            "const": "confirm"
          },
          "proposalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "sessionId",
          "operation",
          "proposalId"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "operation": {
            "const": "publish"
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "sessionId",
          "operation",
          "modelId"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "operation": {
            "const": "finish"
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maintenanceToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "sessionId",
          "operation",
          "modelId",
          "maintenanceToken"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "operation",
          "modelId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "operation": {
            "const": "retry_story"
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "phase"
    ],
    "properties": {
      "phase": {
        "enum": [
          "model",
          "story",
          "maintenance",
          "complete"
        ]
      }
    }
  },
  "executor": {
    "type": "browser_script",
    "path": "run.js",
    "timeoutMs": 15000
  }
}
