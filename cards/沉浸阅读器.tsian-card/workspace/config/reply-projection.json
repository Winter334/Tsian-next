{
  "schema": "tsian.reply-projection.v1",
  "rules": [
    {
      "id": "choices",
      "match": "/\\[\\[选项\\]\\]([\\s\\S]*?)\\[\\[\\/选项\\]\\]/g",
      "text": "",
      "project": {
        "choices": "$1|lines|stripList"
      }
    },
    {
      "id": "opening-choices",
      "match": "/\\[\\[开局选项\\]\\]([\\s\\S]*?)\\[\\[\\/开局选项\\]\\]/g",
      "display": "",
      "project": {
        "openingChoices": "$1|lines|stripList"
      }
    }
  ]
}
