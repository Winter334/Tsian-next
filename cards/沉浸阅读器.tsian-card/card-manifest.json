{
  "schema": "tsian.game-card.v1",
  "id": "local.game-card-2",
  "name": "沉浸阅读器",
  "version": "0.3.1",
  "summary": "导入小说，以原著人物、文风与世界为基础，扮演原著或原创角色。你的行动自然影响本局剧情，已发生的故事逐步形成可查询资料与历史。",
  "author": {
    "name": "流萤白沙"
  },
  "cover": {
    "workspacePath": ".cover/cover.png"
  },
  "frontend": {
    "kind": "packaged",
    "entry": "frontend/dist/index.html",
    "framework": "vue",
    "bridgeVersion": "tsian.play-bridge.v1"
  },
  "runtime": {
    "entrypoints": {
      "playerTurn": "storyteller",
      "postTurnMaintenance": "stage-manager"
    },
    "initialSave": {
      "templateRoot": "initial-save"
    }
  }
}
