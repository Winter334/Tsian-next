-export function reasoningEffortHintForKind(kind: BrowserAiProviderKind): string {
-  if (kind === "openai-responses") {
-    return "以 reasoning.effort 字段发送；请确保你的 API 支持该参数，不支持时选「不发送」并通过自定义请求参数手动指定。"
-  }
