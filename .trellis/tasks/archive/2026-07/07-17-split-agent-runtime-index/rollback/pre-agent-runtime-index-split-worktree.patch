-      }
-      if (raw.text !== undefined) {
-        if (typeof raw.text !== "string") {
-          throw toolError(
-            "INSPECT_FRONTEND_ACTION_TEXT_INVALID",
-            `inspect_frontend actions[${i}].text must be a string.`,
-          )
-        }
-        action.text = raw.text
