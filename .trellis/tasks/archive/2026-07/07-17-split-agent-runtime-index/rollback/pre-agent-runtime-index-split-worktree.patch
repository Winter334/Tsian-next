-      const selector = normalizeRequiredString(
-        raw.selector,
-        "INSPECT_FRONTEND_SELECTOR_REQUIRED",
-        `inspect_frontend actions[${i}].selector must be a non-empty string.`,
-      )
-      const action: InspectDomAction = {
-        type: type as InspectDomActionType,
