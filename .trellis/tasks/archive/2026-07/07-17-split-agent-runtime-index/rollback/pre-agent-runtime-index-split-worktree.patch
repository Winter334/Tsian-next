-function actionExecutorAbortError(
-  executor: RuntimeActionExecutorReference,
-): RuntimeWorkspaceToolError {
-  return toolError(
-    "ACTION_EXECUTOR_ABORTED",
-    `Action executor was aborted: ${executor.type}/${executor.name}`,
-    { executor },
