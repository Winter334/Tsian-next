+  message: MessageLike,
+  mode: "native" | "text",
+): boolean {
+  if (mode === "native") {
+    if (message.role === "tool") return true
+    if (message.role === "assistant" && Array.isArray(message.toolCalls) && message.toolCalls.length > 0) {
